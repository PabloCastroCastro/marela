# Configuración de Docker Compose. Cópialo como .env y ajústalo.
# En el servidor hay un .env por entorno (pruebas y producción). Nunca se versiona el .env.
# En desarrollo (docker-compose.dev.yml) todas las variables tienen valor por defecto y el .env es opcional.

# Entorno del servidor: pruebas o produccion
ENTORNO=produccion

# Puerto del host en el que escucha el proxy, el único puerto publicado.
# Cada entorno del servidor usa uno distinto, y distinto de los que ya estén ocupados en el servidor:
# por ejemplo 8444 en pruebas y 9444 en producción.
PUERTO=8080

# Puerto del proxy que se publica: 8080 (HTTP, en local y en la CI) o 8443 (HTTPS, en el servidor,
# con el certificado de Tailscale montado por docker-compose.servidor.yml)
PUERTO_INTERNO=8080

# Solo servidor: directorio con cert.pem y key.pem de Tailscale. Si el servidor ya tiene un certificado
# de Tailscale para otra aplicación, se puede usar el mismo
CERTIFICADOS=/opt/marela/certs

# PostgreSQL. La contraseña es obligatoria en el servidor: larga y solo con letras y
# números, porque va dentro de la URL de conexión del backend.
POSTGRES_DB=marela
POSTGRES_USER=marela
POSTGRES_PASSWORD=

# Clave con la que se firman las sesiones: distinta en cada entorno y secreta.
# Genérala con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Dirección desde la que se abre la aplicación, p. ej. https://servidor.tailnet.ts.net:8444
# (en local, http://localhost:8080). Solo se aceptan peticiones de autenticación desde ella.
URL_PUBLICA=

# Nivel de log del backend: fatal, error, warn, info, debug o trace
LOG_LEVEL=info

# Tamaño máximo de una subida (fotos y adjuntos), en formato de nginx (25m, 1g)
MAX_SUBIDA=25m

# Zona horaria de todos los servicios
TZ=Europe/Madrid

# --- Solo desarrollo ---

# Puerto local de PostgreSQL
PUERTO_DB=5432

# true para detectar los cambios por sondeo en backend y frontend. Necesario si el código está
# en el sistema de archivos de Windows (C:\...): los cambios no llegan como eventos a los contenedores
RECARGA_POLLING=false
