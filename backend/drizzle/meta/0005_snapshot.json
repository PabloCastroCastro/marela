        },
        "animales_padre_no_propio": {
          "name": "animales_padre_no_propio",
          "value": "\"animales\".\"padre_id\" is distinct from \"animales\".\"id\""
        },
        "animales_origen": {
          "name": "animales_origen",
          "value": "(\"animales\".\"origen\" = 'nacido' and \"animales\".\"fecha_entrada\" is null and \"animales\".\"rega_origen\" is null)\n        or (\"animales\".\"origen\" = 'comprado' and \"animales\".\"fecha_entrada\" is not null\n            and \"animales\".\"rega_origen\" ~ '^ES[0-9]{12}$')"
        },
        "animales_baja": {
          "name": "animales_baja",
          "value": "(\"animales\".\"estado\" = 'activo' and \"animales\".\"fecha_baja\" is null and \"animales\".\"causa_baja\" is null)\n        or (\"animales\".\"estado\" <> 'activo' and \"animales\".\"fecha_baja\" is not null)"
        }
