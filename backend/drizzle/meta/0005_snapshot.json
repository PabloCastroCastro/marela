          "value": "(\"animales\".\"crotal\" ~ '^ES[0-9]{12}$' or (\"animales\".\"crotal\" ~ '^[A-Z]{2}[0-9]{1,12}$' and left(\"animales\".\"crotal\", 2) <> 'ES'))"
